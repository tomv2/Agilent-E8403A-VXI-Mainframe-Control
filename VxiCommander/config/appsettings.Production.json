{
  "socketPath": "/run/vxi-controller/broker.sock",
  "driverRoot": "/usr/lib/vxi-controller/drivers",
  "auditLogPath": "/var/log/vxi-controller/audit.jsonl",
  "inventoryPath": "/var/lib/vxi-controller/inventory.json",
  "buses": [
    {
      "id": "gpib0",
      "transport": "linux-gpib",
      "boardIndex": 0,
      "autoDiscover": true,
      "timeoutCode": 11
    }
  ],
  "web": {
    "enabled": true,
    "bindAddress": "127.0.0.1",
    "port": 8080
  },
  "drivers": [
    {
      "id": "hp.e1472a",
      "directory": "hp-e1472a",
      "executable": "vxi-driver-hpe1472a",
      "allowedCommandPrefixes": ["CLOS (@", "OPEN (@"],
      "allowedCategories": ["relay-switch"],
      "sha256": null
    },
    {
      "id": "hp.e1368a",
      "directory": "hp-e1368a",
      "executable": "vxi-driver-hpe1368a",
      "allowedCommandPrefixes": ["CLOS (@", "OPEN (@"],
      "allowedCategories": ["relay-switch"],
      "sha256": null
    },
    {
      "id": "racal.3271",
      "directory": "racal-3271",
      "executable": "vxi-driver-racal3271",
      "allowedCommandPrefixes": ["*IDN?", "*RST"],
      "allowedCategories": ["query", "reset"],
      "sha256": null
    }
  ],
  "security": {
    "requireHashes": true,
    "maxCommandsPerOperation": 8,
    "minimumRelayDelayMilliseconds": 20
  }
}
